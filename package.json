{
  "name": "ronda",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "db:up": "docker compose up -d db",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js && node db/seed-rio.js && node db/import-crime-occurrences.js",
    "db:fetch-armed-violence": "node --env-file=.env db/fetch-fogo-cruzado.js"
  },
  "devDependencies": {
    "pg": "^8.13.1"
  }
}
